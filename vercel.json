{
  "rewrites": [
    { "source": "/api/login",        "destination": "/api/login.js" },
    { "source": "/api/dados",        "destination": "/api/dados.js" },
    { "source": "/api/salvar",       "destination": "/api/salvar.js" },
    { "source": "/api/migrar",       "destination": "/api/migrar.js" },
    { "source": "/api/trocar-senha", "destination": "/api/trocar-senha.js" },
    { "source": "/api/rotinas",        "destination": "/api/rotinas.js" },
    { "source": "/api/debug",          "destination": "/api/debug.js" },
    { "source": "/api/admin-usuarios", "destination": "/api/admin-usuarios.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
